# Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# Optional: only needed if you later add a SQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voteredge_ai
DB_USER=postgres
DB_PASSWORD=your_password

# Required for the current backend deployment
GEMINI_API_KEY=your_gemini_api_key_here

# CORS
CORS_ORIGIN=http://localhost:5173

# Optional: only needed if you later add custom JWT auth
JWT_SECRET=your_jwt_secret_key

